# GeoMind AI — Database Credentials
# Copy this file to .env and fill in real values
# NEVER commit .env to version control

POSTGRES_USER=geomind
POSTGRES_PASSWORD=geomind
POSTGRES_DB=geomind
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Database connection URL (for scripts)
DATABASE_URL=postgresql://geomind:geomind@localhost:5432/geomind
